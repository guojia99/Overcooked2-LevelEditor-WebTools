{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "assetPath": { "type": "string", "maxLength": 1024, "pattern": "^Assets/LevelSets/[^/\\\\]+/data/[^/\\\\]+/[^/\\\\]+\\.asset$" },
    "respawnBounds": {
      "type": "object", "additionalProperties": false,
      "required": ["assetPath", "enableRespawnBounds", "confirm"],
      "properties": {
        "assetPath": { "$ref": "#/$defs/assetPath" },
        "enableRespawnBounds": { "type": "boolean" },
        "confirm": { "type": "boolean", "const": true }
      }
    },
    "nativeSequence": {
      "type": "object", "additionalProperties": false,
      "required": ["assetPath", "playerCount", "scriptedRecipes", "confirm"],
      "properties": {
        "assetPath": { "$ref": "#/$defs/assetPath" },
        "playerCount": { "type": "integer", "minimum": 1, "maximum": 4 },
        "scriptedRecipes": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" }, "description": "Campaign only. Ordered GUIDs, duplicates preserved; [] explicitly clears. Missing/null is rejected by this save tool." },
        "confirm": { "type": "boolean", "const": true }
      }
    }
  }
}
