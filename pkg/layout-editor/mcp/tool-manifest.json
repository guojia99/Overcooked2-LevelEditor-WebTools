{
  "$schema": "./schemas/tool-manifest.schema.json",
  "protocolVersion": "2025-06-18",
  "server": {
    "name": "oc2-level-editor",
    "version": "0.1.0",
    "transport": "stdio+http",
    "httpEndpoint": "/api/mcp",
    "httpManifestEndpoint": "/api/mcp/manifest",
    "httpToolsEndpoint": "/api/mcp/tools",
    "bridgeUrl": "http://10.211.55.3:8765",
    "bridgeUrlEnvironment": "OC2_EDITOR_BRIDGE_URL"
  },
  "defaults": {
    "pollAfterMs": 2000,
    "readDeadlineMs": 30000,
    "writeDeadlineMs": 120000,
    "exportDeadlineMs": 1800000
  },
  "tools": [
    {
      "name": "oc2_save_level_respawn_bounds",
      "description": "assetPath/enableRespawnBounds:boolean/confirm=true；GET /api/level 合并完整基础标量，POST /api/level/info 显式 updateEnableRespawnBounds=true，再 GET 验证。stdio 与 Unity HTTP 同契约，不自动重试。",
      "category": "level", "sideEffect": "write_asset", "estimatedMs": 30000, "deadlineMs": 180000,
      "safeToRetry": false, "requiresConfirmation": true
    },
    {
      "name": "oc2_save_native_scripted_recipes",
      "description": "assetPath/playerCount:1..4/scriptedRecipes:GUID[]/confirm=true；仅 Campaign。保留顺序重复，[] 清空，缺省/null 拒绝。GET 详情合并指定人数完整标量，仅 POST 此 config_Np，再 GET 逐项验证。不清除 Web 序列、不自动重试。stdio 与 Unity HTTP 同契约。",
      "category": "level", "sideEffect": "write_asset", "estimatedMs": 30000, "deadlineMs": 180000,
      "safeToRetry": false, "requiresConfirmation": true
    },
    {
      "name": "oc2_get_level_mode_config",
      "description": "读取原生模式、阶段/1P-4P波次和 common04 六种敌人目录；Web partLevel 独立。支持 stdio 与 HTTP /api/mcp。",
      "category": "level", "sideEffect": "read", "estimatedMs": 5000, "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_save_level_mode_config",
      "description": "config=完整 Dynamic/Horde DTO，confirm=true；POST /api/level/mode-config，移除只读 enemies，2 MiB 上限，同步本关专属 SO；不切模式，强制 GET 读回核对。读回失败也禁止自动重试。",
      "category": "level", "sideEffect": "write_asset", "estimatedMs": 30000, "deadlineMs": 180000,
      "safeToRetry": false, "requiresConfirmation": true
    },
    {
      "name": "oc2_change_level_mode",
      "description": "assetPath/gameMode/convertHordeObjects?/confirm=true；POST /api/level/mode，convertHordeObjects 精确布尔默认 false。仅用户明确同意 true 才原子双向转换受支持普通 ServingStation/Horde Service_Window wrapper，保留原 GO/位置/名称/回收绑定，改变外观及组件；不得自动开启。金币 gate 不转换，切出前先删除；Horde 允许无金币 gate，仍需激活窗且无普通口。切出用 true 转换最后 Horde 窗，勿预删。场景干净且唯一 Manager，Dynamic 需 N-1 原生有效 transition；partLevel.enabled 拒切 Dynamic/Horde。GET 模式及详情读回。",
      "category": "level", "sideEffect": "write_scene", "estimatedMs": 30000, "deadlineMs": 180000,
      "safeToRetry": false, "requiresConfirmation": true
    },
    {
      "name": "oc2_create_level",
      "description": "setName/levelId/levelName?/levelNameZH?/gameMode?/confirm=true；POST /api/level/create，gameMode 默认 Campaign，可选 Dynamic/Horde。列表解析真实路径后 GET 模式/详情验证，不可盲重试。",
      "category": "level", "sideEffect": "write_scene", "estimatedMs": 30000, "deadlineMs": 180000,
      "safeToRetry": false, "requiresConfirmation": true
    },
    {
      "name": "oc2_editor_health",
      "category": "discovery",
      "sideEffect": "read",
      "estimatedMs": 1000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_list_level_sets",
      "category": "discovery",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_list_levels",
      "category": "discovery",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_level_detail",
      "category": "level",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_scene_layout",
      "category": "scene",
      "sideEffect": "read",
      "estimatedMs": 10000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_grid",
      "category": "scene",
      "sideEffect": "read",
      "estimatedMs": 2000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_level_recipe_context",
      "description": "catalog.recipes 排除 Web_SauceSalad_Optional_ 内部锚点，保留 optional 登记；saladSubgroups 的 non_dlc11_official 独占剧情食材沙拉及其酱扩展，其余的 mustard_only/ketchup_only/both_sauces/no_sauce 互斥，official 为可交叉来源组；按菜谱 id 去重计数。无菜谱写工具；现有 HTTP/Web 保存原版 Cake_Plain_SO 时安全追加煎锅 Web_MixedFlourEgg，混选输入未核验则保留空表原生 lookup。完整混选用前端显式自动填充；另用 oc2_get_scene_layout 读回 cookingUtensil.allowedIngredientGuids，场景仍需写回落盘。",
      "category": "recipes",
      "sideEffect": "read",
      "estimatedMs": 10000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_salad_sauce_bundles",
      "description": "operation=build/status；build 需 confirm=true，仅构建两个 Windows bundle。状态持久化 Library/SaladSauceBundleBuild/result.json；HTTP 超时先读状态，勿盲重试。无场景或 LevelInfo 保存，无发布包。",
      "category": "dependencies",
      "sideEffect": "build",
      "estimatedMs": 300000,
      "deadlineMs": 1800000,
      "safeToRetry": false
    },
    {
      "name": "oc2_analyze_level_dependencies",
      "description": "仅分析原生 ^bundle[0-9]+$ 依赖；读取时自动清理并保存历史非法 dependencies。共享依赖包分发清单独立管理。",
      "category": "dependencies",
      "sideEffect": "compute",
      "estimatedMs": 10000,
      "deadlineMs": 60000,
      "safeToRetry": true
    },
    {
      "name": "oc2_list_level_resource_usage",
      "category": "dependencies",
      "sideEffect": "compute",
      "estimatedMs": 8000,
      "deadlineMs": 60000,
      "safeToRetry": true
    },
    {
      "name": "oc2_validate_scene",
      "category": "scene",
      "sideEffect": "compute",
      "estimatedMs": 10000,
      "deadlineMs": 60000,
      "safeToRetry": true
    },
    {
      "name": "oc2_create_scene_draft",
      "category": "draft",
      "sideEffect": "draft",
      "estimatedMs": 10000,
      "deadlineMs": 60000,
      "safeToRetry": false
    },
    {
      "name": "oc2_apply_scene_patch",
      "category": "draft",
      "sideEffect": "draft",
      "estimatedMs": 1000,
      "deadlineMs": 30000,
      "safeToRetry": false
    },
    {
      "name": "oc2_validate_scene_draft",
      "category": "draft",
      "sideEffect": "compute",
      "estimatedMs": 1000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_diff_scene_draft",
      "category": "draft",
      "sideEffect": "compute",
      "estimatedMs": 1000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_commit_scene_draft",
      "category": "scene",
      "sideEffect": "write_scene",
      "estimatedMs": 30000,
      "deadlineMs": 120000,
      "safeToRetry": false,
      "requiresConfirmation": true
    },
    {
      "name": "oc2_list_writeback_history",
      "category": "history",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_writeback_diff",
      "category": "history",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_commit_scene",
      "description": "提交场景写回；后端严格 Prepare 并保存场景与资源，任一步骤失败则请求失败。成功后自动刷新预览，无需再手动 Ctrl+S；请重新读取场景验证，或关闭并重开场景核对磁盘内容。",
      "category": "scene",
      "sideEffect": "write_scene",
      "estimatedMs": 30000,
      "deadlineMs": 120000,
      "safeToRetry": false,
      "requiresConfirmation": true,
      "httpOnly": true
    },
    {
      "name": "oc2_list_custom_content",
      "category": "custom-content",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_custom_content_templates",
      "category": "custom-content",
      "sideEffect": "read",
      "estimatedMs": 2000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_custom_content_catalog",
      "category": "custom-content",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_start_export",
      "description": "启动导出，接受响应含后端 exportId，状态持续携带同一 ID。编译挂起重载继续，其他阶段重载明确 error 并恢复场景和备份。启动响应不确定时先读状态，禁止自动重放 POST。",
      "category": "export",
      "sideEffect": "build",
      "estimatedMs": 300000,
      "deadlineMs": 1800000,
      "pollAfterMs": 2000,
      "safeToRetry": false,
      "requiresConfirmation": true
    },
    {
      "name": "oc2_get_export_status",
      "description": "查询包含 exportId、mode、stages 的后台状态快照。单次请求应设超时；断线/idle 不代表完成，核对任务 ID 后继续轮询至 restore 收尾及 done/error。",
      "category": "export",
      "sideEffect": "read",
      "estimatedMs": 1000,
      "deadlineMs": 30000,
      "safeToRetry": true
    }
  ]
}
