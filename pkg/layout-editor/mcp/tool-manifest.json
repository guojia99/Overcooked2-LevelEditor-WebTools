{
  "$schema": "./schemas/tool-manifest.schema.json",
  "protocolVersion": "2025-06-18",
  "server": {
    "name": "oc2-level-editor",
    "version": "0.1.0",
    "transport": "stdio+http",
    "httpEndpoint": "/api/mcp",
    "httpManifestEndpoint": "/api/mcp/manifest",
    "httpToolsEndpoint": "/api/mcp/tools",
    "bridgeUrl": "http://10.211.55.3:8765",
    "bridgeUrlEnvironment": "OC2_EDITOR_BRIDGE_URL"
  },
  "defaults": {
    "pollAfterMs": 2000,
    "readDeadlineMs": 30000,
    "writeDeadlineMs": 120000,
    "exportDeadlineMs": 1800000
  },
  "tools": [
    {
      "name": "oc2_editor_health",
      "category": "discovery",
      "sideEffect": "read",
      "estimatedMs": 1000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_list_level_sets",
      "category": "discovery",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_list_levels",
      "category": "discovery",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_level_detail",
      "category": "level",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_scene_layout",
      "category": "scene",
      "sideEffect": "read",
      "estimatedMs": 10000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_grid",
      "category": "scene",
      "sideEffect": "read",
      "estimatedMs": 2000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_level_recipe_context",
      "description": "catalog.recipes 排除 Web_SauceSalad_Optional_ 内部锚点，保留 optional 登记；saladSubgroups 的 non_dlc11_official 独占剧情食材沙拉及其酱扩展，其余的 mustard_only/ketchup_only/both_sauces/no_sauce 互斥，official 为可交叉来源组；按菜谱 id 去重计数。",
      "category": "recipes",
      "sideEffect": "read",
      "estimatedMs": 10000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_salad_sauce_bundles",
      "description": "operation=build/status；build 需 confirm=true，仅构建两个 Windows bundle。状态持久化 Library/SaladSauceBundleBuild/result.json；HTTP 超时先读状态，勿盲重试。无场景或 LevelInfo 保存，无发布包。",
      "category": "dependencies",
      "sideEffect": "build",
      "estimatedMs": 300000,
      "deadlineMs": 1800000,
      "safeToRetry": false
    },
    {
      "name": "oc2_analyze_level_dependencies",
      "category": "dependencies",
      "sideEffect": "compute",
      "estimatedMs": 10000,
      "deadlineMs": 60000,
      "safeToRetry": true
    },
    {
      "name": "oc2_list_level_resource_usage",
      "category": "dependencies",
      "sideEffect": "compute",
      "estimatedMs": 8000,
      "deadlineMs": 60000,
      "safeToRetry": true
    },
    {
      "name": "oc2_validate_scene",
      "category": "scene",
      "sideEffect": "compute",
      "estimatedMs": 10000,
      "deadlineMs": 60000,
      "safeToRetry": true
    },
    {
      "name": "oc2_create_scene_draft",
      "category": "draft",
      "sideEffect": "draft",
      "estimatedMs": 10000,
      "deadlineMs": 60000,
      "safeToRetry": false
    },
    {
      "name": "oc2_apply_scene_patch",
      "category": "draft",
      "sideEffect": "draft",
      "estimatedMs": 1000,
      "deadlineMs": 30000,
      "safeToRetry": false
    },
    {
      "name": "oc2_validate_scene_draft",
      "category": "draft",
      "sideEffect": "compute",
      "estimatedMs": 1000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_diff_scene_draft",
      "category": "draft",
      "sideEffect": "compute",
      "estimatedMs": 1000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_commit_scene_draft",
      "category": "scene",
      "sideEffect": "write_scene",
      "estimatedMs": 30000,
      "deadlineMs": 120000,
      "safeToRetry": false,
      "requiresConfirmation": true
    },
    {
      "name": "oc2_list_writeback_history",
      "category": "history",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_writeback_diff",
      "category": "history",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_commit_scene",
      "category": "scene",
      "sideEffect": "write_scene",
      "estimatedMs": 30000,
      "deadlineMs": 120000,
      "safeToRetry": false,
      "requiresConfirmation": true,
      "httpOnly": true
    },
    {
      "name": "oc2_list_custom_content",
      "category": "custom-content",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_custom_content_templates",
      "category": "custom-content",
      "sideEffect": "read",
      "estimatedMs": 2000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_custom_content_catalog",
      "category": "custom-content",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_start_export",
      "category": "export",
      "sideEffect": "build",
      "estimatedMs": 300000,
      "deadlineMs": 1800000,
      "pollAfterMs": 2000,
      "safeToRetry": false,
      "requiresConfirmation": true
    },
    {
      "name": "oc2_get_export_status",
      "category": "export",
      "sideEffect": "read",
      "estimatedMs": 1000,
      "deadlineMs": 30000,
      "safeToRetry": true
    }
  ]
}
