{
  "$schema": "./schemas/tool-manifest.schema.json",
  "protocolVersion": "2025-06-18",
  "server": {
    "name": "oc2-level-editor",
    "version": "0.1.0",
    "transport": "stdio+http",
    "httpEndpoint": "/api/mcp",
    "httpManifestEndpoint": "/api/mcp/manifest",
    "httpToolsEndpoint": "/api/mcp/tools",
    "bridgeUrl": "http://10.211.55.3:8765",
    "bridgeUrlEnvironment": "OC2_EDITOR_BRIDGE_URL"
  },
  "defaults": {
    "pollAfterMs": 2000,
    "readDeadlineMs": 30000,
    "writeDeadlineMs": 120000,
    "exportDeadlineMs": 1800000
  },
  "tools": [
    {
      "name": "oc2_editor_health",
      "category": "discovery",
      "sideEffect": "read",
      "estimatedMs": 1000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_list_level_sets",
      "category": "discovery",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_list_levels",
      "category": "discovery",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_level_detail",
      "category": "level",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_scene_layout",
      "category": "scene",
      "sideEffect": "read",
      "estimatedMs": 10000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_grid",
      "category": "scene",
      "sideEffect": "read",
      "estimatedMs": 2000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_level_recipe_context",
      "description": "catalog.recipes 排除 Web_SauceSalad_Optional_ 内部锚点，保留 optional 登记；saladSubgroups 的 non_dlc11_official 独占剧情食材沙拉及其酱扩展，其余的 mustard_only/ketchup_only/both_sauces/no_sauce 互斥，official 为可交叉来源组；按菜谱 id 去重计数。无菜谱写工具；现有 HTTP/Web 保存原版 Cake_Plain_SO 时安全追加煎锅 Web_MixedFlourEgg，混选输入未核验则保留空表原生 lookup。完整混选用前端显式自动填充；另用 oc2_get_scene_layout 读回 cookingUtensil.allowedIngredientGuids，场景仍需写回落盘。",
      "category": "recipes",
      "sideEffect": "read",
      "estimatedMs": 10000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_salad_sauce_bundles",
      "description": "operation=build/status；build 需 confirm=true，仅构建两个 Windows bundle。状态持久化 Library/SaladSauceBundleBuild/result.json；HTTP 超时先读状态，勿盲重试。无场景或 LevelInfo 保存，无发布包。",
      "category": "dependencies",
      "sideEffect": "build",
      "estimatedMs": 300000,
      "deadlineMs": 1800000,
      "safeToRetry": false
    },
    {
      "name": "oc2_analyze_level_dependencies",
      "category": "dependencies",
      "sideEffect": "compute",
      "estimatedMs": 10000,
      "deadlineMs": 60000,
      "safeToRetry": true
    },
    {
      "name": "oc2_list_level_resource_usage",
      "category": "dependencies",
      "sideEffect": "compute",
      "estimatedMs": 8000,
      "deadlineMs": 60000,
      "safeToRetry": true
    },
    {
      "name": "oc2_validate_scene",
      "category": "scene",
      "sideEffect": "compute",
      "estimatedMs": 10000,
      "deadlineMs": 60000,
      "safeToRetry": true
    },
    {
      "name": "oc2_create_scene_draft",
      "category": "draft",
      "sideEffect": "draft",
      "estimatedMs": 10000,
      "deadlineMs": 60000,
      "safeToRetry": false
    },
    {
      "name": "oc2_apply_scene_patch",
      "category": "draft",
      "sideEffect": "draft",
      "estimatedMs": 1000,
      "deadlineMs": 30000,
      "safeToRetry": false
    },
    {
      "name": "oc2_validate_scene_draft",
      "category": "draft",
      "sideEffect": "compute",
      "estimatedMs": 1000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_diff_scene_draft",
      "category": "draft",
      "sideEffect": "compute",
      "estimatedMs": 1000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_commit_scene_draft",
      "category": "scene",
      "sideEffect": "write_scene",
      "estimatedMs": 30000,
      "deadlineMs": 120000,
      "safeToRetry": false,
      "requiresConfirmation": true
    },
    {
      "name": "oc2_list_writeback_history",
      "category": "history",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_writeback_diff",
      "category": "history",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_commit_scene",
      "description": "提交场景写回；后端严格 Prepare 并保存场景与资源，任一步骤失败则请求失败。成功后自动刷新预览，无需再手动 Ctrl+S；请重新读取场景验证，或关闭并重开场景核对磁盘内容。",
      "category": "scene",
      "sideEffect": "write_scene",
      "estimatedMs": 30000,
      "deadlineMs": 120000,
      "safeToRetry": false,
      "requiresConfirmation": true,
      "httpOnly": true
    },
    {
      "name": "oc2_list_custom_content",
      "category": "custom-content",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_custom_content_templates",
      "category": "custom-content",
      "sideEffect": "read",
      "estimatedMs": 2000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_get_custom_content_catalog",
      "category": "custom-content",
      "sideEffect": "read",
      "estimatedMs": 5000,
      "deadlineMs": 30000,
      "safeToRetry": true
    },
    {
      "name": "oc2_start_export",
      "description": "启动增量导出，自动预检空可选包。levels 仅交付关卡且不 staging 运行时；all/deps 携带依赖闭包。构建 map 保留可达共享资源归属。单集/多集/deps 共用 mode 与 stages 快照，deps 不适用阶段为 skipped。立即返回后轮询至 restore 收尾及 status=done/error，失败不重复启动；需要 confirm=true。",
      "category": "export",
      "sideEffect": "build",
      "estimatedMs": 300000,
      "deadlineMs": 1800000,
      "pollAfterMs": 2000,
      "safeToRetry": false,
      "requiresConfirmation": true
    },
    {
      "name": "oc2_get_export_status",
      "description": "查询 SetExportStatusDto 线程安全深拷贝快照：mode；stages[] 每行 phase/state(waiting|running|done|error|skipped)/elapsedMs/completed/total/message。固定行序 queued、starting、compile、preflight、orphan-clean、dual-stub-clean、prepare、build、package、zip、restore。只按后端快照展示进度/耗时，total=0 用不确定条；prepare 为真实已完成 n/N，非当前处理索引，不按历史耗时估预算。失败原阶段保持 error，restore 独立运行后终态 error，面板保留可关闭。缺 stages 的旧后端仅文字；idle/断网保留已知行，不推断完成。compile 域重载由 SessionState 恢复累计，仅重载缺口用 UTC 墙钟，其余用 Stopwatch。每 2 秒轮询至 restore 收尾及 status=done/error；zip 不代表完成。",
      "category": "export",
      "sideEffect": "read",
      "estimatedMs": 1000,
      "deadlineMs": 30000,
      "safeToRetry": true
    }
  ]
}
