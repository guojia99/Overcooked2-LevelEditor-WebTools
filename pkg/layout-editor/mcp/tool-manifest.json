    { "name": "oc2_start_export", "category": "export", "sideEffect": "build", "estimatedMs": 300000, "deadlineMs": 1800000, "pollAfterMs": 2000, "safeToRetry": false, "requiresConfirmation": true },
    { "name": "oc2_get_export_status", "category": "export", "sideEffect": "read", "estimatedMs": 1000, "deadlineMs": 30000, "safeToRetry": true }
