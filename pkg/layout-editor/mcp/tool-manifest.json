    { "name": "oc2_list_level_sets", "category": "discovery", "sideEffect": "read", "estimatedMs": 5000, "deadlineMs": 30000, "safeToRetry": true },
    { "name": "oc2_list_levels", "category": "discovery", "sideEffect": "read", "estimatedMs": 5000, "deadlineMs": 30000, "safeToRetry": true },
    { "name": "oc2_get_level_detail", "category": "level", "sideEffect": "read", "estimatedMs": 5000, "deadlineMs": 30000, "safeToRetry": true },
    { "name": "oc2_get_scene_layout", "category": "scene", "sideEffect": "read", "estimatedMs": 10000, "deadlineMs": 30000, "safeToRetry": true },
    { "name": "oc2_get_grid", "category": "scene", "sideEffect": "read", "estimatedMs": 2000, "deadlineMs": 30000, "safeToRetry": true },
    { "name": "oc2_get_level_recipe_context", "category": "recipes", "sideEffect": "read", "estimatedMs": 10000, "deadlineMs": 30000, "safeToRetry": true },
